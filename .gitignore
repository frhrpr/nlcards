# These are /dev/null bind-mounts created by the Claude Code sandbox, not
# real files. They show up as untracked and clutter `git status`.
.bash_profile
.bashrc
.gitconfig
.gitmodules
.idea
.mcp.json
.profile
.ripgreprc
.vscode
.zprofile
.zshrc

# Local Claude Code state. Remove this line if you ever add project skills
# or hooks that should be shared.
.claude/

# API keys — read by tools/, never committed
.env

# LibreOffice / Excel lock files, created when a CSV is open
.~lock.*#
~$*

# review page output (regenerated by tools/review.py)
.out/

# supplied images before conversion (converted copies live in media/img)
media/img/*.part

# smoke test scratch module
.smoke.mjs

# python bytecode from importing tools/ directly
__pycache__/
